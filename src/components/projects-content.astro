---
import { CONFIG } from "../lib/consts";
import { fetchPinnedRepos } from "../lib/github";
import type { Project } from "../lib/projects";

const repos = await fetchPinnedRepos(CONFIG.PROJECTS.githubUsername);

const projects: Project[] = repos.map((repo) => ({
  name: repo.name,
  description: repo.description,
  url: repo.html_url,
  where: "GitHub",
}));
---

{
  projects.map((project) => (
    <div class="grid grid-cols-[1fr_2fr_1fr] gap-x-4 border-t border-foreground/10 py-2">
      <a href={project.url} target="_blank" rel="noopener noreferrer">
        {project.name}
      </a>
      <span class="text-sm sm:text-xs leading-5">
        {project.description ?? "—"}
      </span>
      <span class="text-right text-sm sm:text-xs leading-5">
        {project.where}
      </span>
    </div>
  ))
}
