---
import { CONFIG } from "../lib/consts";
import { fetchTopTracks } from "../lib/spotify";
import VinylCover from "./vinyl-cover.astro";
import SpotifyLogo from "./logos/spotify-logo.astro";

const { profileUrl, entries } = await fetchTopTracks(CONFIG.SPOTIFY.limit);
---

<section
  class="flex flex-col gap-4 rounded-lg bg-card p-4 sm:flex-row sm:items-center sm:justify-between"
>
  <div class="flex items-center justify-between gap-4 sm:block sm:min-w-0">
    <div class="min-w-0">
      <a href={profileUrl} target="_blank" rel="noopener noreferrer">
        {CONFIG.SPOTIFY.title}
      </a>
      <p class="text-sm sm:text-xs text-muted">{CONFIG.SPOTIFY.description}</p>
    </div>
    <SpotifyLogo class="size-6 shrink-0 sm:hidden" />
  </div>

  <div
    class="-mx-4 w-[calc(100%+2rem)] -my-2 overflow-x-auto py-2 sm:mx-0 sm:my-0 sm:w-auto sm:overflow-visible sm:py-0 [-ms-overflow-style:none] scrollbar-none [&::-webkit-scrollbar]:hidden"
  >
    <div class="flex w-max pl-5 sm:pl-3">
      {
        entries.map((entry, index) => (
          <a
            href={entry.link}
            target="_blank"
            rel="noopener noreferrer"
            class:list={[
              "group/vinyl relative block h-14 w-14 shrink-0 transition-transform duration-200 ease-out hover:-translate-y-1.5 hover:z-10",
              index > 0 && "-ml-2",
            ]}
            style={`z-index: ${entries.length - index}`}
            title={`${entry.title} — ${entry.artist}`}
          >
            <VinylCover albumArtUrl={entry.albumArtUrl} title={entry.title} />
          </a>
        ))
      }
    </div>
  </div>
</section>
