<div data-dialog class="inline">
  <button
    type="button"
    class="dialog-trigger cursor-pointer underline decoration-dotted underline-offset-[3px] hover:decoration-solid"
  >
    Colophon
  </button>

  <dialog
    class="dialog w-full max-w-md space-y-4 rounded-lg border-0 bg-card p-6 pt-5 text-foreground shadow-lg"
    aria-labelledby="colophon-title"
  >
    <h2 id="colophon-title" class="font-medium text-base sm:text-sm">
      About this site
    </h2>
    <div class="space-y-3 text-sm sm:text-xs leading-5">
      <p>
        This website is my personal hub. It pulls in as much content as possible
        from the places I already update, so it stays current without me
        rewriting the same details in several spots.
      </p>
      <p>
        Profile details come from GitHub. Projects, movies, books, and music are
        synced from GitHub, Letterboxd, Hardcover, and Spotify.
      </p>
    </div>
  </dialog>
</div>
