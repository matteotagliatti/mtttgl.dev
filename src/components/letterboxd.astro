---
import { CONFIG } from "../lib/consts";
import { fetchDiaryEntries } from "../lib/letterboxd";

const entries = await fetchDiaryEntries(
  CONFIG.LETTERBOXD.username,
  CONFIG.LETTERBOXD.limit,
);

const posters = entries;
---

<section
  class="flex flex-col gap-4 rounded-lg bg-muted/15 p-4 sm:flex-row sm:items-center sm:justify-between"
>
  <div class="min-w-0">
    <a href={CONFIG.LETTERBOXD.url} target="_blank" rel="noopener noreferrer">
      Letterboxd
    </a>
    <p class="text-xs text-muted">Recently watched</p>
  </div>

  <div
    class="w-full overflow-x-auto sm:w-auto sm:overflow-visible [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
  >
    <div class="flex w-max pl-1 sm:pl-3">
      {
        posters.map((entry, index) => (
          <a
            href={entry.link}
            target="_blank"
            rel="noopener noreferrer"
            class:list={[
              "relative block h-[72px] w-12 shrink-0 overflow-hidden rounded-sm ring-1 ring-foreground/10 transition-transform duration-200 ease-out hover:-translate-y-1.5 hover:z-10",
              index > 0 && "-ml-3",
            ]}
            style={`z-index: ${posters.length - index}`}
            title={entry.title}
          >
            {entry.posterUrl ? (
              <img
                src={entry.posterUrl}
                alt={entry.title}
                width={48}
                height={72}
                class="h-full w-full object-cover"
                loading="lazy"
              />
            ) : (
              <span class="flex h-full w-full items-center justify-center bg-muted/30 text-[10px] text-muted">
                —
              </span>
            )}
          </a>
        ))
      }
    </div>
  </div>
</section>
