---
import { CONFIG } from "../lib/consts";
import { fetchDiaryEntries } from "../lib/letterboxd";
import DvdCover from "./dvd-cover.astro";

const entries = await fetchDiaryEntries(
  CONFIG.LETTERBOXD.username,
  CONFIG.LETTERBOXD.limit,
);

const posters = entries;
---

<section
  class="flex flex-col gap-4 rounded-lg bg-card p-4 sm:flex-row sm:items-center sm:justify-between"
>
  <div class="min-w-0">
    <a href={CONFIG.LETTERBOXD.url} target="_blank" rel="noopener noreferrer">
      {CONFIG.LETTERBOXD.title}
    </a>
    <p class="text-xs text-muted">{CONFIG.LETTERBOXD.description}</p>
  </div>

  <div
    class="w-full overflow-x-auto sm:w-auto sm:overflow-visible [-ms-overflow-style:none] scrollbar-none [&::-webkit-scrollbar]:hidden"
  >
    <div class="flex w-max pl-1 sm:pl-3">
      {
        posters.map((entry, index) => (
          <a
            href={entry.link}
            target="_blank"
            rel="noopener noreferrer"
            class:list={[
              "group/dvd relative block h-[72px] w-12 shrink-0 transition-transform duration-200 ease-out hover:-translate-y-1.5 hover:z-10",
              index > 0 && "-ml-2",
            ]}
            style={`z-index: ${posters.length - index}`}
            title={entry.title}
          >
            <DvdCover posterUrl={entry.posterUrl} title={entry.title} />
          </a>
        ))
      }
    </div>
  </div>
</section>
