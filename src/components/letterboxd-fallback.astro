---
import { CONFIG } from "../lib/consts";
import DvdCover from "./dvd-cover.astro";
---

<section
  aria-hidden="true"
  class="flex flex-col gap-4 rounded-lg bg-card p-4 sm:flex-row sm:items-center sm:justify-between"
>
  <div class="min-w-0">
    <span class="font-medium">{CONFIG.LETTERBOXD.title}</span>
    <p class="text-xs text-muted">{CONFIG.LETTERBOXD.description}</p>
  </div>

  <div class="flex shrink-0 pl-1 sm:pl-3">
    {
      Array.from({ length: CONFIG.LETTERBOXD.limit }).map((_, index) => (
        <span
          class:list={[
            "block h-[72px] w-12 shrink-0",
            index > 0 && "-ml-2",
          ]}
        >
          <DvdCover />
        </span>
      ))
    }
  </div>
</section>
