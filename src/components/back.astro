---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<a
  href="/"
  class:list={["inline-flex items-center gap-1.5 text-muted", className]}
>
  <svg
    width="24"
    height="24"
    viewBox="0 0 24 24"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
    class="size-5"
  >
    <path
      d="M20.25 6V11.75C20.25 12.8546 19.3546 13.75 18.25 13.75H4.75M7.75 9.75L3.75 13.75L7.75 17.75"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
  </svg>
  <slot />
</a>
