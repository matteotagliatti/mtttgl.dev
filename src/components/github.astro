---
import { CONFIG } from "../lib/consts";
import { fetchPinnedRepos } from "../lib/github";

const projects = await fetchPinnedRepos(CONFIG.GITHUB.username);
---

<section>
  <div
    class="grid grid-cols-[auto_1fr_2fr_1fr] gap-x-4 pb-2 text-muted text-sm sm:text-xs"
    aria-hidden="true"
  >
    <span>#</span>
    <span>Project</span>
    <span>Description</span>
    <span class="text-right">Language</span>
  </div>

  {
    projects.map((project, index) => (
      <div class="grid grid-cols-[auto_1fr_2fr_1fr] gap-x-4 border-t border-foreground/10 py-2">
        <span class="text-muted tabular-nums">{index + 1}</span>
        <a href={project.html_url} target="_blank" rel="noopener noreferrer">
          {project.name}
        </a>
        <span class="text-sm sm:text-xs leading-5">
          {project.description ?? "—"}
        </span>
        <span class="text-right text-sm sm:text-xs leading-5 ">
          {project.language ?? "—"}
        </span>
      </div>
    ))
  }
</section>
