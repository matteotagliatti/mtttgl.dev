---
import { CONFIG } from "../lib/consts";
import { fetchRecentlyRead } from "../lib/hardcover";
import BookCover from "./book-cover.astro";

const { profileUrl, entries } = await fetchRecentlyRead(CONFIG.HARDCOVER.limit);
---

<section
  class="flex flex-col gap-4 rounded-lg bg-card p-4 sm:flex-row sm:items-center sm:justify-between"
>
  <div class="min-w-0">
    <a href={profileUrl} target="_blank" rel="noopener noreferrer">
      {CONFIG.HARDCOVER.title}
    </a>
    <p class="text-xs text-muted">{CONFIG.HARDCOVER.description}</p>
  </div>

  <div
    class="w-full overflow-x-auto sm:w-auto sm:overflow-visible [-ms-overflow-style:none] scrollbar-none [&::-webkit-scrollbar]:hidden"
  >
    <div class="flex w-max pl-1 sm:pl-3">
      {
        entries.map((entry, index) => (
          <a
            href={entry.link}
            target="_blank"
            rel="noopener noreferrer"
            class:list={[
              "group/book relative block h-[72px] w-12 shrink-0 transition-transform duration-200 ease-out hover:-translate-y-1.5 hover:z-10",
              index > 0 && "-ml-3",
            ]}
            style={`z-index: ${entries.length - index}`}
            title={entry.title}
          >
            <BookCover coverUrl={entry.coverUrl} title={entry.title} />
          </a>
        ))
      }
    </div>
  </div>
</section>
