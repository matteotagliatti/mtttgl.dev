---
interface Props {
  posterUrl?: string | null;
  title?: string;
}

const { posterUrl = null, title = "" } = Astro.props;
---

<div class="relative h-[72px] w-12 perspective-[180px]">
  <div
    class="relative h-full w-full transform-3d transform-[rotateY(-18deg)] transition-transform duration-200 ease-out group-hover/dvd:transform-[rotateY(-9deg)]"
  >
    <div
      class="absolute inset-y-0 right-[-5px] w-2 rounded-r-sm border-r border-foreground/10 bg-[linear-gradient(90deg,oklch(0.9_0.002_286),oklch(0.66_0.002_286),oklch(0.96_0.002_286))] shadow-[2px_2px_4px_oklch(0_0_0/0.16)] transform-[translateZ(-4px)_rotateY(56deg)]"
      aria-hidden="true"
    >
    </div>

    <div
      class="absolute bottom-px left-[-3px] top-px w-[6px] origin-right rounded-l-sm bg-[oklch(0.55_0.002_286)] shadow-[-2px_1px_3px_oklch(0_0_0/0.18)] transform-[translateZ(-3px)_rotateY(-72deg)]"
      aria-hidden="true"
    >
    </div>

    <div
      class="absolute inset-0 overflow-hidden rounded-[3px] bg-foreground ring-1 ring-foreground/15 shadow-[2px_3px_5px_oklch(0_0_0/0.2)] transform-[translateZ(2px)]"
    >
      {
        posterUrl ? (
          <img
            src={posterUrl}
            alt={title}
            width={48}
            height={72}
            class="h-full w-full object-cover"
            loading="lazy"
          />
        ) : (
          <span class="flex h-full w-full items-center justify-center bg-muted/30 text-[10px] text-muted">
            —
          </span>
        )
      }

      <div
        class="pointer-events-none absolute inset-0 rounded-[3px] ring-1 ring-inset ring-white/25"
        aria-hidden="true"
      >
      </div>
    </div>
  </div>
</div>
