---
interface Props {
  posterUrl?: string | null;
  title?: string;
}

const { posterUrl = null, title = "" } = Astro.props;
---

<div class="relative h-[84px] w-14 perspective-[180px]">
  <div
    class="relative h-full w-full transform-3d transform-[rotateY(-18deg)] transition-transform duration-200 ease-out group-hover/dvd:transform-[rotateY(-9deg)]"
  >
    <div
      class="absolute inset-y-0 right-[-2px] w-1 rounded-r-sm border-r border-foreground/10 bg-placeholder shadow-[1px_1px_2px_oklch(0_0_0/0.14)] transform-[translateZ(-2px)_rotateY(56deg)]"
      aria-hidden="true"
    >
    </div>

    <div
      class="absolute bottom-px left-[-2px] top-px w-[3px] origin-right rounded-l-sm bg-placeholder shadow-[-1px_1px_2px_oklch(0_0_0/0.16)] transform-[translateZ(-1.5px)_rotateY(-72deg)]"
      aria-hidden="true"
    >
    </div>

    <div
      class="absolute inset-0 overflow-hidden rounded-[3px] bg-foreground ring-1 ring-foreground/15 shadow-[1px_2px_3px_oklch(0_0_0/0.18)] transform-[translateZ(1px)]"
    >
      {
        posterUrl ? (
          <img
            src={posterUrl}
            alt={title}
            width={56}
            height={84}
            class="h-full w-full object-cover"
            loading="lazy"
          />
        ) : (
          <span class="flex h-full w-full items-center justify-center bg-placeholder text-[10px] text-muted">
            —
          </span>
        )
      }

      <div
        class="pointer-events-none absolute inset-0 rounded-[3px] ring-1 ring-inset ring-white/25"
        aria-hidden="true"
      >
      </div>
    </div>
  </div>
</div>
