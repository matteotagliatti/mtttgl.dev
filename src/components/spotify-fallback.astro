---
import { CONFIG } from "../lib/consts";
import VinylCover from "./vinyl-cover.astro";
---

<div aria-hidden="true" class="flex w-max pl-5 sm:pl-3">
  {
    Array.from({ length: CONFIG.SPOTIFY.limit }).map((_, index) => (
      <span
        class:list={[
          "group/vinyl relative block h-14 w-14 shrink-0 transition-transform duration-200 ease-out",
          index > 0 && "-ml-2",
        ]}
        style={`z-index: ${CONFIG.SPOTIFY.limit - index}`}
      >
        <VinylCover />
      </span>
    ))
  }
</div>
