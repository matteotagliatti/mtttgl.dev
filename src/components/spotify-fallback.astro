---
import { CONFIG } from "../lib/consts";
import VinylCover from "./vinyl-cover.astro";
---

<section
  aria-hidden="true"
  class="flex flex-col gap-4 rounded-lg bg-card p-4 sm:flex-row sm:items-center sm:justify-between"
>
  <div class="min-w-0">
    <span>{CONFIG.SPOTIFY.title}</span>
    <p class="text-xs text-muted">{CONFIG.SPOTIFY.description}</p>
  </div>

  <div
    class="w-full -my-2 overflow-x-auto py-2 sm:my-0 sm:w-auto sm:overflow-visible sm:py-0 [-ms-overflow-style:none] scrollbar-none [&::-webkit-scrollbar]:hidden"
  >
    <div class="flex w-max pl-1 sm:pl-3">
      {
        Array.from({ length: CONFIG.SPOTIFY.limit }).map((_, index) => (
          <span
            class:list={[
              "group/vinyl relative block h-12 w-12 shrink-0 transition-transform duration-200 ease-out",
              index > 0 && "-ml-2",
            ]}
            style={`z-index: ${CONFIG.SPOTIFY.limit - index}`}
          >
            <VinylCover />
          </span>
        ))
      }
    </div>
  </div>
</section>
