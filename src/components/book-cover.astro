---
interface Props {
  coverUrl?: string | null;
  title?: string;
}

const { coverUrl = null, title = "" } = Astro.props;
---

<div class="relative h-[72px] w-12 perspective-[120px]">
  <div
    class="relative h-full w-full transform-3d transform-[rotateY(-16deg)] transition-transform duration-200 ease-out group-hover/book:transform-[rotateY(-8deg)]"
  >
    <div
      class="absolute inset-0 overflow-hidden rounded-sm ring-1 ring-foreground/10 transform-[translateZ(0.5px)]"
    >
      {
        coverUrl ? (
          <img
            src={coverUrl}
            alt={title}
            width={48}
            height={72}
            class="h-full w-full object-cover"
            loading="lazy"
          />
        ) : (
          <span class="flex h-full w-full items-center justify-center bg-muted/30 text-[10px] text-muted">
            —
          </span>
        )
      }
    </div>
  </div>
</div>
