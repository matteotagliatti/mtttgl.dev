---
import { CONFIG } from "../lib/consts";
import BookCover from "./book-cover.astro";
---

<div aria-hidden="true" class="flex w-max pl-5 sm:pl-3">
  {
    Array.from({ length: CONFIG.HARDCOVER.limit }).map((_, index) => (
      <span
        class:list={[
          "group/book relative block h-[84px] w-14 shrink-0 transition-transform duration-200 ease-out",
          index > 0 && "-ml-2",
        ]}
        style={`z-index: ${CONFIG.HARDCOVER.limit - index}`}
      >
        <BookCover />
      </span>
    ))
  }
</div>
