---
export const prerender = true;

import Layout from "../layouts/Layout.astro";
import Github from "../components/github.astro";
import GithubFallback from "../components/github-fallback.astro";
import Letterboxd from "../components/letterboxd.astro";
import LetterboxdFallback from "../components/letterboxd-fallback.astro";
import Hardcover from "../components/hardcover.astro";
import HardcoverFallback from "../components/hardcover-fallback.astro";
import { CONFIG } from "../lib/consts";
---

<Layout>
  <section class="space-y-4">
    <p>
      Hi, I'm Matteo. <span class="font-medium">Full-stack developer</span> with a
      passion for building web and native applications with an eye for design. Experienced
      in <span class="font-medium">TypeScript</span> (React, React Native, Node.js
      and other frameworks), <span class="font-medium">Go</span> and{" "}
      <span class="font-medium">PHP</span> (Laravel). Simplicity and elegance are
      my guiding principles.
    </p>
    <p class="text-xs text-muted">
      {
        CONFIG.SOCIAL_LINKS.map((link, index) => (
          <>
            {index > 0 && " • "}
            <a target="_blank" rel="noopener noreferrer" href={link.href}>
              {link.text}
            </a>
          </>
        ))
      }
    </p>
  </section>
  <Github server:defer>
    <GithubFallback slot="fallback" />
  </Github>
  <div class="space-y-4">
    <Letterboxd server:defer>
      <LetterboxdFallback slot="fallback" />
    </Letterboxd>
    <Hardcover server:defer>
      <HardcoverFallback slot="fallback" />
    </Hardcover>
  </div>
</Layout>
