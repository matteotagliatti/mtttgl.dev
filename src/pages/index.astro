---
export const prerender = true;

import Layout from "../layouts/Layout.astro";
import Github from "../components/github.astro";
import GithubFallback from "../components/github-fallback.astro";
import Letterboxd from "../components/letterboxd.astro";
import LetterboxdFallback from "../components/letterboxd-fallback.astro";
import Hardcover from "../components/hardcover.astro";
import HardcoverFallback from "../components/hardcover-fallback.astro";
import Spotify from "../components/spotify.astro";
import SpotifyFallback from "../components/spotify-fallback.astro";
import { CONFIG } from "../lib/consts";

function social(text: string) {
  return CONFIG.SOCIAL_LINKS.find((link) => link.text === text)?.href ?? "#";
}
---

<Layout>
  <section class="space-y-4">
    <img
      src={`https://github.com/${CONFIG.GITHUB.username}.png?size=160`}
      alt={CONFIG.SITE.TITLE}
      width={80}
      height={80}
      class="size-10 rounded-full ring-1 ring-foreground/10"
      loading="eager"
    />
    <p>
      Hi, I'm Matteo. <span class="font-medium">Full-stack developer</span> with a
      passion for building web and native applications with an eye for design. Experienced
      in <span class="font-medium">TypeScript</span> (React, React Native, Node.js
      and other frameworks), <span class="font-medium">Go</span> and{" "}
      <span class="font-medium">PHP</span> (Laravel). Simplicity and elegance are
      my guiding principles.
    </p>
    <div class="text-muted text-sm sm:text-xs space-y-1">
      <p>
        Feel free to{" "}
        <a href={social("Email")}>email me</a>.
      </p>
      <p>
        I'm also on{" "}
        <a href={social("GitHub")} target="_blank" rel="noopener noreferrer"
          >GitHub</a
        >,{" "}
        <a href={social("LinkedIn")} target="_blank" rel="noopener noreferrer"
          >LinkedIn</a
        >,{" "}
        <a href={social("Instagram")} target="_blank" rel="noopener noreferrer"
          >Instagram</a
        > and{" "}
        <a href={social("X")} target="_blank" rel="noopener noreferrer">X</a>.
      </p>
    </div>
  </section>
  <Github server:defer>
    <GithubFallback slot="fallback" />
  </Github>
  <div class="space-y-4">
    <Letterboxd server:defer>
      <LetterboxdFallback slot="fallback" />
    </Letterboxd>
    <Hardcover server:defer>
      <HardcoverFallback slot="fallback" />
    </Hardcover>
    <Spotify server:defer>
      <SpotifyFallback slot="fallback" />
    </Spotify>
  </div>
</Layout>
