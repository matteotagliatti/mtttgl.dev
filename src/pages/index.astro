---
export const prerender = true;

import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import ProjectsContent from "../components/projects-content.astro";
import ProjectsFallback from "../components/projects-fallback.astro";
import { toProject } from "../lib/projects";
import FeedCard from "../components/feed-card.astro";
import LetterboxdContent from "../components/letterboxd-content.astro";
import LetterboxdFallback from "../components/letterboxd-fallback.astro";
import HardcoverContent from "../components/hardcover-content.astro";
import HardcoverFallback from "../components/hardcover-fallback.astro";
import SpotifyContent from "../components/spotify-content.astro";
import SpotifyFallback from "../components/spotify-fallback.astro";
import LetterboxdLogo from "../components/logos/letterboxd-logo.astro";
import HardcoverLogo from "../components/logos/hardcover-logo.astro";
import SpotifyLogo from "../components/logos/spotify-logo.astro";
import WorkingAt from "../components/working-at.astro";
import WorkingAtFallback from "../components/working-at-fallback.astro";
import BasedIn from "../components/based-in.astro";
import BasedInFallback from "../components/based-in-fallback.astro";
import { CONFIG } from "../lib/consts";

function social(text: string) {
  return CONFIG.SOCIAL_LINKS.find((link) => link.text === text)?.href ?? "#";
}
---

<Layout className="space-y-12">
  <section class="space-y-4">
    <Image
      src={`https://github.com/${CONFIG.PROJECTS.githubUsername}.png?size=160`}
      alt={CONFIG.SITE.TITLE}
      width={80}
      height={80}
      class="size-10 rounded-full ring-1 ring-foreground/10"
      loading="eager"
    />
    <p>
      Hi, I'm Matteo. <span class="font-medium">Full-stack developer</span>{" "}
      based in <BasedIn server:defer
        ><BasedInFallback slot="fallback" /></BasedIn
      >, currently working at <WorkingAt server:defer
        ><WorkingAtFallback slot="fallback" /></WorkingAt
      >. Experienced in <span class="font-medium">TypeScript</span> (React, React
      Native, Node.js and other frameworks), <span class="font-medium">Go</span> and{
        " "
      }
      <span class="font-medium">PHP</span> (Laravel). Simplicity and elegance are
      my guiding principles.
    </p>
    <div class="text-muted text-sm sm:text-xs space-y-1">
      <p>
        Feel free to{" "}
        <a href={social("Email")}>email me</a>.
      </p>
      <p>
        I'm also on{" "}
        <a href={social("GitHub")} target="_blank" rel="noopener noreferrer"
          >GitHub</a
        >,{" "}
        <a href={social("LinkedIn")} target="_blank" rel="noopener noreferrer"
          >LinkedIn</a
        >,{" "}
        <a href={social("Instagram")} target="_blank" rel="noopener noreferrer"
          >Instagram</a
        > and{" "}
        <a href={social("X")} target="_blank" rel="noopener noreferrer">X</a>.
      </p>
    </div>
  </section>
  <section>
    <div
      class="grid grid-cols-[1fr_2fr_1fr] gap-x-4 pb-2 text-muted text-sm sm:text-xs"
      aria-hidden="true"
    >
      <span>Project</span>
      <span>Description</span>
      <span class="text-right">Where</span>
    </div>
    {
      CONFIG.PROJECTS.static.map((project) => {
        const entry = toProject(project);
        return (
          <div class="grid grid-cols-[1fr_2fr_1fr] gap-x-4 border-t border-foreground/10 py-2">
            <a href={entry.url} target="_blank" rel="noopener noreferrer">
              {entry.name}
            </a>
            <span class="text-sm sm:text-xs leading-5">
              {entry.description ?? "—"}
            </span>
            <span class="text-right text-sm sm:text-xs leading-5">
              {entry.where}
            </span>
          </div>
        );
      })
    }
    <ProjectsContent server:defer>
      <ProjectsFallback slot="fallback" />
    </ProjectsContent>
  </section>
  <div class="space-y-4">
    <FeedCard
      title={CONFIG.LETTERBOXD.title}
      description={CONFIG.LETTERBOXD.description}
      href={CONFIG.LETTERBOXD.url}
    >
      <LetterboxdLogo slot="logo" class="h-4 w-auto shrink-0 sm:hidden" />
      <LetterboxdContent server:defer>
        <LetterboxdFallback slot="fallback" />
      </LetterboxdContent>
    </FeedCard>
    <FeedCard
      title={CONFIG.HARDCOVER.title}
      description={CONFIG.HARDCOVER.description}
      href={CONFIG.HARDCOVER.url}
    >
      <HardcoverLogo slot="logo" class="size-8 shrink-0 sm:hidden" />
      <HardcoverContent server:defer>
        <HardcoverFallback slot="fallback" />
      </HardcoverContent>
    </FeedCard>
    <FeedCard
      title={CONFIG.SPOTIFY.title}
      description={CONFIG.SPOTIFY.description}
      href={CONFIG.SPOTIFY.url}
    >
      <SpotifyLogo slot="logo" class="size-6 shrink-0 sm:hidden" />
      <SpotifyContent server:defer>
        <SpotifyFallback slot="fallback" />
      </SpotifyContent>
    </FeedCard>
  </div>
</Layout>
