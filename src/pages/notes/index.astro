---
export const prerender = true;

import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Back from "../../components/back.astro";

const notes = (await getCollection("notes")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<Layout
  title="Notes"
  description="Personal notes and lists."
  className="space-y-8"
>
  <section class="space-y-4">
    <Back />
    <h1 class="font-medium">Notes</h1>
  </section>

  <section>
    <div
      class="grid grid-cols-[1fr_auto] gap-x-4 pb-2 text-muted text-sm sm:text-xs"
      aria-hidden="true"
    >
      <span>Note</span>
      <span class="text-right">Date</span>
    </div>
    {
      notes.map((note) => (
        <div class="grid grid-cols-[1fr_auto] gap-x-4 border-t border-foreground/10 py-2">
          <a href={`/notes/${note.id}`}>{note.data.title}</a>
          <span class="text-right text-sm sm:text-xs leading-5 tabular-nums">
            {
              note.data.date.toLocaleDateString("en-GB", {
                day: "numeric",
                month: "short",
                year: "numeric",
              })
            }
          </span>
        </div>
      ))
    }
  </section>
</Layout>
